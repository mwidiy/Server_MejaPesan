generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  googleId  String?  @unique
  role      String   @default("cashier")
  fcmToken  String?
  createdAt DateTime @default(now())
  store     Store?
}

model Store {
  id                           Int          @id @default(autoincrement())
  name                         String       @default("Nama Resto")
  logo                         String?
  qrisImage                    String?
  whatsappNumber               String?
  isOpen                       Boolean      @default(true)
  ownerId                      Int          @unique
  updatedAt                    DateTime     @updatedAt
  bankName                     String?
  bankNumber                   String?
  bankHolder                   String?
  ewalletType                  String?
  ewalletNumber                String?
  ewalletName                  String?
  isKasirQrVerificationEnabled Boolean      @default(false)
  cashPaymentMode              String       @default("post")
  isCashActive                 Boolean      @default(true)
  
  // Fitur Baru: Toggle Metode Pesanan
  isDineInActive               Boolean      @default(true)
  isTakeawayActive             Boolean      @default(true)
  isDeliveryActive             Boolean      @default(false)
  isWaBotActive                Boolean      @default(false)
  
  arAssets                     ArAsset[]
  banners                      Banner[]
  categories                   Category[]
  locations                    Location[]
  orders                       Order[]
  products                     Product[]
  owner                        User         @relation(fields: [ownerId], references: [id])
  withdrawals                  Withdrawal[]
}

model Withdrawal {
  id            Int      @id @default(autoincrement())
  amount        Int
  status        String   @default("Pending")
  method        String
  bankName      String
  accountNumber String
  accountName   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  storeId       Int
  store         Store    @relation(fields: [storeId], references: [id])
}

model Location {
  id      Int     @id @default(autoincrement())
  name    String
  storeId Int
  store   Store   @relation(fields: [storeId], references: [id])
  tables  Table[]
}

model Table {
  id         Int      @id @default(autoincrement())
  name       String
  qrCode     String   @unique
  isActive   Boolean  @default(true)
  locationId Int
  orders     Order[]
  location   Location @relation(fields: [locationId], references: [id])
}

model Category {
  id              Int       @id @default(autoincrement())
  name            String
  defaultPrepTime Int       @default(10) // Fitur Baru: Default waktu masak per kategori (dalam menit)
  storeId         Int
  store           Store     @relation(fields: [storeId], references: [id])
  products        Product[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  categoryId  Int
  price       Int
  image       String?
  description String?
  isActive    Boolean     @default(true)
  prepTime    Int         @default(5)
  ar3dModel   String?
  isArActive  Boolean     @default(false)
  storeId     Int
  orderItems  OrderItem[]
  category    Category    @relation(fields: [categoryId], references: [id])
  store       Store       @relation(fields: [storeId], references: [id])
}

model Banner {
  id            Int      @id @default(autoincrement())
  title         String
  subtitle      String?
  highlightText String?
  image         String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  storeId       Int
  store         Store    @relation(fields: [storeId], references: [id])
}

model Order {
  id                 Int         @id @default(autoincrement())
  transactionCode    String      @unique
  queueNumber        Int         @default(0)
  expiresAt          DateTime?
  createdAt          DateTime    @default(now())
  tableId            Int?
  customerName       String
  orderType          String
  paymentMethod      String?
  paymentStatus      String      @default("Unpaid")
  status             String      @default("Pending")
  totalAmount        Int
  targetTime         DateTime?
  note               String?
  deliveryAddress    String?
  customerPhone      String?
  customerPhoneSig   String?
  customerPhoneJidType String?
  cancellationReason String?
  cancellationStatus String?
  refundStatus       String?
  storeId            Int
  store              Store       @relation(fields: [storeId], references: [id])
  table              Table?      @relation(fields: [tableId], references: [id])
  items              OrderItem[]

  @@index([status, createdAt])
  @@index([transactionCode])
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  orderId       Int
  productId     Int
  quantity      Int
  priceSnapshot Int
  note          String?
  order         Order   @relation(fields: [orderId], references: [id])
  product       Product @relation(fields: [productId], references: [id])
}

model ArAsset {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  createdAt DateTime @default(now())
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
